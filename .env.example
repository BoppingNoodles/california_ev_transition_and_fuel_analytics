# Copy to .env and fill in. .env is gitignored.

# NREL developer key for the AFDC alt-fuel stations API (https://developer.nrel.gov/signup/)
# DEMO_KEY works but is heavily rate-limited; replace it with your own key.
NREL_API_KEY=DEMO_KEY

# Census API key for ACS demographics (https://api.census.gov/data/key_signup.html)
CENSUS_API_KEY=
